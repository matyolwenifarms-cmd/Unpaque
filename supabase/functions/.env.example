# Secrets for `supabase functions serve` (local) or `supabase secrets set
# --env-file` (deployed). Copy to supabase/functions/.env, which is gitignored.

ANTHROPIC_API_KEY=

# MUST be replaced with a real random value for any deployed project. Generate
# one with `openssl rand -hex 32`, or in PowerShell:
#
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
#
# It salts the hash of each caller's IP address so the rate-limit table can
# recognise a repeat visitor without being able to name one. A salt that is
# published in a repository does not do that: an unsalted-in-effect hash of an
# IPv4 address is reversible by anyone willing to walk 4.3 billion candidates.
# Left as the placeholder below, the function refuses to serve.
RATE_LIMIT_SALT=REPLACE_ME

# Global daily ceiling. Low while evaluating: each analysis is roughly 8-9 US
# cents, so 50 is about $4.50/day at full tilt.
ANALYSES_PER_DAY=50
