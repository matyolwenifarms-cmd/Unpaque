{
  "name": "unpaque",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Unpaque \u2014 communication diagnostics engine. Names the rhetorical structure of a text, traceable to communication theory.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:verify": "./scripts/verify-schema.sh",
    "deploy": "supabase db push && supabase functions deploy analyse && supabase functions deploy research-search",
    "deploy:status": "supabase migration list",
    "smoke": "node scripts/smoke-test.mjs",
    "research:record": "node scripts/record-fixtures.mjs",
    "smoke:ui": "vite build && node scripts/smoke-ui.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.1",
    "@supabase/supabase-js": "^2.47.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "supabase": "^2.111.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^3.0.0"
  }
}
